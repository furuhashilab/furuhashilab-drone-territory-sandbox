<?xml version="1.0" encoding="UTF-8"?>
<!--
  合成データ（実際の飛行ログではありません）。
  <time> を持たない GPX で、Parser がエラーを返すことを確認するための異常系サンプルです。
  座標は synthetic_normal.gpx と同じ明らかなダミー値（35.0N / 135.0E 起点）。
-->
<gpx version="1.1" creator="furuhashilab-drone-territory-sandbox (synthetic)"
     xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>synthetic_no_time</name>
    <trkseg>
      <trkpt lat="35.0000000" lon="135.0000000"><ele>100.0</ele></trkpt>
      <trkpt lat="35.0000000" lon="135.0001000"><ele>105.0</ele></trkpt>
      <trkpt lat="35.0000000" lon="135.0002000"><ele>110.0</ele></trkpt>
      <trkpt lat="35.0000000" lon="135.0003000"><ele>115.0</ele></trkpt>
    </trkseg>
  </trk>
</gpx>
